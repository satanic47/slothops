# ==============================================================================
# SlothOps Environment Configuration - Hacktoberfest 2026 Week 3
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# 1. Thinking Machines (Tinker) Configuration
# Get your API key from https://console.thinkingmachines.ai/
TINKER_API_KEY=your_thinking_machines_tinker_api_key_here
TINKER_BASE_MODEL=meta-llama/Llama-3-8B-Instruct
TINKER_FINE_TUNED_MODEL=sloth-distill-v1

# 2. Backboard.io (Stateful Memory & Unified Model Gateway)
# Get your API key from https://backboard.io/dashboard
BACKBOARD_API_KEY=your_backboard_io_api_key_here
BACKBOARD_BASE_URL=https://api.backboard.io/v1
BACKBOARD_MEMORY_COLLECTION=slothops_user_preferences

# 3. Render (Cloud Deployment & Background Worker)
# Render automatically injects PORT and RENDER=true in production
RENDER_SERVICE_NAME=slothops-api
RENDER_API_KEY=your_render_api_key_here
RENDER_EXTERNAL_URL=https://slothops.onrender.com

# 4. .tech Domains Configuration
# Free domain claimed via https://hacktoberfest.com/my/promos/
TECH_CUSTOM_DOMAIN=slothops.tech
TECH_CNAME_TARGET=slothops.onrender.com
